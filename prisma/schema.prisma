generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  password          String
  balance           Float              @default(990)
  realBalance       Float              @default(0)
  lastDemoReset     DateTime?
  image             String?
  emailVerified     Boolean            @default(false)
  verifyToken       String?            @unique
  referralCode      String?            @unique
  referredBy        String?
  winRateOverride   Float?
  isBlocked         Boolean            @default(false)
  adminNote         String?
  affiliateId       String?
  affiliateLinkSlug String?
  onboardingDone    Boolean            @default(false)
  firstDepositDone  Boolean            @default(false)
  totalDeposited    Float              @default(0)
  affiliate         Affiliate?         @relation(fields: [affiliateId], references: [id])
  trades            Trade[]
  withdrawals       Withdrawal[]
  affiliateEarnings AffiliateEarning[]
  dailyMissions     DailyMission[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([affiliateId])
}

model DailyMission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String
  type      String
  progress  Int      @default(0)
  target    Int      @default(1)
  claimed   Boolean  @default(false)
  rewardUsd Float    @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, date, type])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model AdminSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AffiliateEarning {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  referredId    String
  depositAmount Float
  commission    Float
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Trade {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  asset      String
  direction  String
  amount     Float
  entryPrice Float
  exitPrice  Float?
  duration   Int
  result     String   @default("PENDING")
  profit     Float    @default(0)
  mode       String   @default("demo")
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([result])
  @@index([expiresAt])
  @@index([userId, result])
}

model Withdrawal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  method    String
  details   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Affiliate {
  id                String                @id @default(cuid())
  name              String
  email             String                @unique
  password          String
  balance           Float                 @default(0)
  totalEarned       Float                 @default(0)
  pixKey            String?
  commissionRate    Float                 @default(0.90)
  level             Int                   @default(1)
  parentAffiliateId String?
  photo             String?
  phone             String?
  cpf               String?
  docType           String?
  docNumber         String?
  lastWithdrawalAt  DateTime?
  status            String                @default("ACTIVE")
  parentAffiliate   Affiliate?            @relation("AffiliateHierarchy", fields: [parentAffiliateId], references: [id])
  subAffiliates     Affiliate[]           @relation("AffiliateHierarchy")
  links             AffiliateLink[]
  revenues          AffiliateRevenue[]
  withdrawals       AffiliateWithdrawal[]
  referredUsers     User[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([parentAffiliateId])
  @@index([status])
  @@index([parentAffiliateId, status])
}

model AffiliateLink {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  slug        String    @unique
  title       String
  clicks      Int       @default(0)
  conversions Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([affiliateId])
}

model AffiliateRevenue {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  userId      String
  tradeId     String
  amount      Float
  createdAt   DateTime  @default(now())

  @@index([affiliateId])
  @@index([userId])
  @@index([tradeId])
}

model AffiliateWithdrawal {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  amount      Float
  pixKey      String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())

  @@index([affiliateId])
  @@index([status])
}

model DepositLog {
  id         String   @id @default(cuid())
  userId     String
  externalId String   @unique
  amount     Float
  currency   String
  provider   String
  status     String
  createdAt  DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  actorType String
  action    String
  target    String?
  meta      String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actor])
  @@index([actorType])
  @@index([action])
  @@index([createdAt])
}

model SupportTicket {
  id         String          @id @default(cuid())
  subject    String
  status     String          @default("OPEN")
  priority   String          @default("NORMAL")
  authorType String
  authorId   String
  messages   TicketMessage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([authorType, authorId])
  @@index([status])
  @@index([createdAt])
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  authorType String
  authorId   String
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}
